/* Defines the semantic location hierarchy of the camper, including
   the vehicle itself and its individual rooms, areas and storage spaces. */

Group Camper "Wohnmobil" <none> ["Location"]

Group GasLocker "Gaskasten" <gas> (Camper)  ["Location"]  { widgetOrder="5" }
Group Technical "Technikbereich" <settings> (Camper) ["Location"]  { widgetOrder="6" }
Group RearGarage "Heckgarage" <suitcase> (Camper) ["Location"]  { widgetOrder="4" }

Group Cabin "Fahrerhaus" <parents_1_1> (Camper) ["Location"] { widgetOrder="1" }
Group Dinette "Dinette" <sofa> (Camper) ["Location"] { widgetOrder="2" }
Group Sleeping "Schlafen" <bedroom> (Camper)  ["Location"]  { widgetOrder="3" }