Thing bluetooth:listener:hci0:mopeka "Mopeka Pro" (bluetooth:bluez:hci0) [address="__CAMPERPILOT_MOPEKAPRO_ADDRESS__", changeByteOrder=false, autoChannelCreation=true, dataTimeout=1] {
	Channels:
		Type rssi : rssi "RSSI"
		Type advertise-interval : interval "Advertising Interval"
		Type manufacturer-raw : manufacturer-data "Manufacturer raw data" [dataBegin=0, dataLength=0]
}
