Thing zigbee:coordinator_ember:stick "Zigbee USB Stick" [
    zigbee_port="__CAMPERPILOT_ZIGBEE_PORT__",
    zigbee_baud=115200,
    zigbee_flowcontrol=2,
    zigbee_childtimeout=86400,
    zigbee_concentrator=0,
    zigbee_meshupdateperiod=86400,
    zigbee_panid=__CAMPERPILOT_ZIGBEE_PAN_ID__,
    zigbee_extendedpanid="__CAMPERPILOT_ZIGBEE_EXTENDED_PAN_ID__",
    zigbee_networkkey="__CAMPERPILOT_ZIGBEE_NETWORK_KEY__",
    zigbee_powermode=1,
    zigbee_txpower=0
    ]
