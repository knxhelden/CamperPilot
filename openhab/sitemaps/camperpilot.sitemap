sitemap camperpilot label="CamperPilot" {
    // CAMPERPILOT_MOPEKAPRO_BEGIN
    // Frame label="Gas" {
    //     Text item=Mopekapro_Level valuecolor=[>30="green", >15="orange", <=15="red"]
    //     Text item=Mopekapro_Quality label="Messqualität [%d/3]" valuecolor=[>=3="green", ==2="orange", <=1="red"]
    //     Text item=Mopekapro_Temperature valuecolor=[>=55="red", >=45="orange", <45="green"]
    // }
    // CAMPERPILOT_MOPEKAPRO_END
    Frame label="System" {
        Text label="Überwachung" icon="shield" {
            Frame label="Alarmanlage" {
                Switch item=Security_AlarmSystem_Armed
            }
            Frame label="Temperaturalarm" {
                Switch item=Climate_TemperatureAlarm_Enabled
            }
        }
        Text label="CamperPilot" icon="settings" {
            Frame label="Vitalwerte" {
                Text item=System_CamperPilot_CPU_Temperature valuecolor=[>=80="red", >=70="orange", >=60="gold", >=0="green", "gray"]
                Text item=System_CamperPilot_CPU_Load valuecolor=[>=90="red", >=75="orange", >=50="gold", >=0="green", "gray"]
                Text item=System_CamperPilot_RAM_UsedPercent valuecolor=[>=90="red", >=80="orange", >=65="gold", >=0="green", "gray"]
                Text item=System_CamperPilot_RAM_Used
            }
            Frame label="Netzwerk" {
                Text item=System_CamperPilot_Network_IP
                Text item=System_CamperPilot_Network_MAC
            }
            Frame label="Steuerung" {
                Switch item=System_CamperPilot_Shutdown label="Herunterfahren"
                Switch item=System_CamperPilot_Reboot label="Neustarten"
            }
        }
    }
}
